<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light"
    tools:context=".MateriFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/CustomTextView18Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:text="Materi Praktikum"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:text="Daftar materi yang telah dipelajari selama praktikum."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <TextView
            style="@style/MaterialItem"
            android:text="01  Pengenalan Android Studio" />

        <TextView
            style="@style/MaterialItem"
            android:text="02  Layout dan XML" />

        <TextView
            style="@style/MaterialItem"
            android:text="03  Activity dan Intent" />

        <TextView
            style="@style/MaterialItem"
            android:text="04  Fragment" />

        <TextView
            style="@style/MaterialItem"
            android:text="05  Options Menu" />

        <TextView
            style="@style/MaterialItem"
            android:text="06  TabLayout dan ViewPager2" />

        <TextView
            style="@style/MaterialItem"
            android:text="07  Custom Style dan Rounded Button" />

    </LinearLayout>
</ScrollView>
